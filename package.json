{
    "type": "module",
    "private": true,
    "scripts": {
        "generateCss": "node --import=./build/preload.ts ./src/cron/generateCss.ts ./dist/web/client/generated",
        "scrapeUsers": "node --import=./build/preload.ts ./src/cron/scrapeUsers.ts",
        "startWeb": "   node    -r source-map-support/register ./dist/web/server/www.cjs",
        "watchWeb": "   nodemon -r source-map-support/register ./dist/web/server/www.cjs --watch ./dist/web/server",
        "devWebClient": "NODE_ENV=development webpack serve   --config build/webpack.config.web.client.ts",
        "devWebServer": "NODE_ENV=development webpack --watch --config build/webpack.config.web.server.ts",
        "buildWebClient": "                   webpack         --config build/webpack.config.web.client.ts && sentry-cli sourcemaps inject ./dist/web/client",
        "buildWebServer": "                   webpack         --config build/webpack.config.web.server.ts && sentry-cli sourcemaps inject ./dist/web/server",
        "dev": "concurrently 'pnpm devWebClient' 'pnpm devWebServer'",
        "build": "pnpm buildWebClient && pnpm buildWebServer",
        "test": "pnpm unit && playwright test",
        "unit": "vitest",
        "e2e": "playwright test",
        "lint": "vue-tsc && eslint",
        "analyze": "WEBPACK_ANALYZE=true NODE_ENV=production webpack --config build/webpack.config.web.client.ts"
    },
    "dependencies": {
        "@sentry/node": "^11.4.0",
        "@sinclair/typebox": "^0.34.52",
        "better-sqlite3": "^13.0.3",
        "date-fns": "^4.4.0",
        "dotenv": "^18.0.5",
        "drizzle-orm": "^0.45.3",
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.2.0",
        "redis": "^6.3.0",
        "source-map-support": "^0.5.21"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@nuxt/devalue": "^2.0.2",
        "@playwright/test": "^1.63.0",
        "@rollup/plugin-replace": "^6.0.3",
        "@sentry/cli": "^3.8.0",
        "@sentry/vue": "^11.4.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/http-errors": "^2.0.5",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.6.4",
        "@types/supertest": "^7.2.1",
        "@types/webpack-bundle-analyzer": "^4.7.0",
        "@types/webpack-env": "^1.18.8",
        "@unhead/vue": "^3.4.2",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/server-renderer": "^3.5.43",
        "concurrently": "^10.0.5",
        "connect-redis": "^10.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "cors": "^2.8.6",
        "css-loader": "^7.1.5",
        "esbuild-loader": "^4.5.0",
        "eslint": "^10.12.0",
        "eslint-plugin-n": "^18.4.1",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "html-webpack-plugin": "^5.6.8",
        "http-errors": "^2.0.1",
        "mini-css-extract-plugin": "^2.10.2",
        "morgan": "^1.12.1",
        "null-loader": "^4.0.1",
        "pinia": "^4.0.3",
        "quasar": "^2.34.0",
        "quasar-unused-plugin": "^0.3.11",
        "responsive-loader": "^3.1.2",
        "sass": "^1.105.1",
