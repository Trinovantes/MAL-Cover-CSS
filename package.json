        "typescript": "^7.0.2",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.2",
        "vitest": "^5.0.3",
        "vue": "^3.5.43",
        "vue-eslint-parser": "^10.4.1",
        "vue-loader": "^17.4.2",
        "vue-router": "^5.3.1",
        "vue-ssr-assets-plugin": "^0.4.11",
        "vue-tsc": "^3.3.12",
        "webpack": "^5.111.1",
